# ============================================
# A.N.N. Notification Service — Railway Environment
# ============================================

PORT=8004
LOG_LEVEL=info
WORKERS=2

# ── Redis ────────────────────────────────────
REDIS_URL=redis://default:password@redis.railway.internal:6379

# ── Social Media ─────────────────────────────
TWITTER_BEARER_TOKEN=
FACEBOOK_PAGE_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
SOCIAL_AUTO_POST=false

# ── Telegram ─────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# ── WhatsApp ─────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ── YouTube ──────────────────────────────────
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=
