# ===================================================================
# A.N.N. — Master Railway Environment Variables Reference
# ===================================================================
# This file documents ALL environment variables needed across services.
# DO NOT deploy this file. Use it as reference when configuring Railway.
#
# Railway auto-injects these when you add plugins:
#   PostgreSQL → DATABASE_URL, DATABASE_PUBLIC_URL, PGHOST, PGPORT, PGUSER, PGPASSWORD, PGDATABASE
#   Redis      → REDIS_URL, REDIS_PUBLIC_URL, REDISHOST, REDISPORT, REDISUSER, REDISPASSWORD
#   Each service → PORT, RAILWAY_ENVIRONMENT, RAILWAY_PUBLIC_DOMAIN
# ===================================================================

# ══════════════════════════════════════════════════════════════════════
# SHARED VARIABLES (set as Railway Project-level Shared Variables)
# ══════════════════════════════════════════════════════════════════════

# ── LLM Brain ────────────────────────────────
LLM_API_KEY=sk-your-openai-key
LLM_MODEL=gpt-4o
LLM_BASE_URL=https://api.openai.com/v1

# ── Supabase ─────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key-NOT-anon
SUPABASE_JWT_SECRET=your-jwt-secret

# ── Media Production ─────────────────────────
ELEVENLABS_API_KEY=your_key
ELEVENLABS_VOICE_EN=voice_id
ELEVENLABS_VOICE_HI=voice_id

HEYGEN_API_KEY=your_key
HEYGEN_AVATAR_EN=avatar_id
HEYGEN_AVATAR_HI=avatar_id

# ── News Ingestion ───────────────────────────
NEWS_API_KEY=your_newsapi_key
ALPHA_VANTAGE_KEY=your_key

# ══════════════════════════════════════════════════════════════════════
# PER-SERVICE VARIABLES
# ══════════════════════════════════════════════════════════════════════

# ── API Gateway (public-facing) ──────────────
# PORT=8000                  (auto-injected by Railway)
CORS_ORIGINS=https://ann-frontend.vercel.app
AUTH_SERVICE_URL=http://ann-auth-service.railway.internal:8001
ARTICLE_SERVICE_URL=http://ann-article-service.railway.internal:8002
VIDEO_SERVICE_URL=http://ann-video-service.railway.internal:8003
NOTIFICATION_SERVICE_URL=http://ann-notification-service.railway.internal:8004
ANALYTICS_SERVICE_URL=http://ann-analytics-service.railway.internal:8005
SEARCH_SERVICE_URL=http://ann-search-service.railway.internal:8006

# ── Social Media (notification-service only) ─
TWITTER_BEARER_TOKEN=
FACEBOOK_PAGE_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=
