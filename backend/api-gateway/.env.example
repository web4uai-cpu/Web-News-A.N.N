# ============================================
# A.N.N. API Gateway — Railway Environment
# ============================================
# Set these in Railway Dashboard → Service → Variables
# Railway auto-injects: PORT, RAILWAY_ENVIRONMENT, RAILWAY_PUBLIC_DOMAIN

# ── Server ───────────────────────────────────
PORT=8000
LOG_LEVEL=info
WORKERS=2
CORS_ORIGINS=https://ann-frontend.vercel.app,https://your-custom-domain.com

# ── Downstream Services (Railway internal URLs) ─
# Use Railway's private networking: servicename.railway.internal
AUTH_SERVICE_URL=http://ann-auth-service.railway.internal:8001
ARTICLE_SERVICE_URL=http://ann-article-service.railway.internal:8002
VIDEO_SERVICE_URL=http://ann-video-service.railway.internal:8003
NOTIFICATION_SERVICE_URL=http://ann-notification-service.railway.internal:8004
ANALYTICS_SERVICE_URL=http://ann-analytics-service.railway.internal:8005
SEARCH_SERVICE_URL=http://ann-search-service.railway.internal:8006

# ── Redis (Railway plugin — auto-injected) ───
# REDIS_URL is auto-injected by Railway when you add Redis plugin
REDIS_URL=redis://default:password@redis.railway.internal:6379

# ── Rate Limiting ────────────────────────────
RATE_LIMIT_ANONYMOUS_RPM=60
RATE_LIMIT_AUTHENTICATED_RPM=600
