# ============================================
# A.N.N. Auth Service — Railway Environment
# ============================================

PORT=8001
LOG_LEVEL=info
WORKERS=2

# ── Database (Railway PostgreSQL — auto-injected) ─
# DATABASE_URL is auto-injected by Railway when you link the Postgres plugin
DATABASE_URL=postgresql://user:pass@postgres.railway.internal:5432/railway

# ── Supabase Auth ────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ── Redis ────────────────────────────────────
REDIS_URL=redis://default:password@redis.railway.internal:6379
