# ============================================
# A.N.N. Video Service — Railway Environment
# ============================================

PORT=8003
LOG_LEVEL=info
WORKERS=2

# ── Database ─────────────────────────────────
DATABASE_URL=postgresql://user:pass@postgres.railway.internal:5432/railway

# ── Redis ────────────────────────────────────
REDIS_URL=redis://default:password@redis.railway.internal:6379

# ── Media APIs ───────────────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_key
ELEVENLABS_VOICE_EN=voice_id_en
ELEVENLABS_VOICE_HI=voice_id_hi
ELEVENLABS_VOICE_ES=voice_id_es
ELEVENLABS_VOICE_FR=voice_id_fr
ELEVENLABS_VOICE_AR=voice_id_ar

HEYGEN_API_KEY=your_heygen_key
HEYGEN_AVATAR_EN=avatar_id_en
HEYGEN_AVATAR_HI=avatar_id_hi
