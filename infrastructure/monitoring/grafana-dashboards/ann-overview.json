{
  "dashboard": {
    "title": "A.N.N. System Overview",
    "tags": ["ann", "overview"],
    "timezone": "browser",
    "refresh": "30s",
    "panels": [
      {
        "title": "Service Health",
        "type": "stat",
        "gridPos": { "h": 4, "w": 12, "x": 0, "y": 0 },
        "targets": [
          {
            "expr": "count(up == 1)",
            "legendFormat": "Services Up"
          }
        ]
      },
      {
        "title": "Request Rate",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
        "targets": [
          {
            "expr": "sum(rate(http_requests_total[5m])) by (job)",
            "legendFormat": "{{ job }}"
          }
        ]
      },
      {
        "title": "Error Rate",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m])) by (job)",
            "legendFormat": "{{ job }} errors"
          }
        ]
      },
      {
        "title": "P95 Latency",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, job))",
            "legendFormat": "{{ job }}"
          }
        ]
      },
      {
        "title": "Pipeline Throughput",
        "type": "stat",
        "gridPos": { "h": 4, "w": 12, "x": 12, "y": 0 },
        "targets": [
          {
            "expr": "increase(pipeline_runs_total{status=\"completed\"}[24h])",
            "legendFormat": "Articles/24h"
          }
        ]
      },
      {
        "title": "Agent Performance",
        "type": "table",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
        "targets": [
          {
            "expr": "avg(agent_execution_seconds) by (agent_name)",
            "legendFormat": "{{ agent_name }}"
          }
        ]
      },
      {
        "title": "Redis Memory",
        "type": "gauge",
        "gridPos": { "h": 4, "w": 6, "x": 0, "y": 20 },
        "targets": [
          {
            "expr": "redis_memory_used_bytes / redis_memory_max_bytes",
            "legendFormat": "Memory Usage"
          }
        ]
      },
      {
        "title": "Postgres Connections",
        "type": "gauge",
        "gridPos": { "h": 4, "w": 6, "x": 6, "y": 20 },
        "targets": [
          {
            "expr": "pg_stat_activity_count / pg_settings_max_connections",
            "legendFormat": "Connection Usage"
          }
        ]
      }
    ]
  }
}
